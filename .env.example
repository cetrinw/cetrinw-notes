# Sample only. Export these variables in the server process environment.
CETRINW_BIND=127.0.0.1:4318
CETRINW_DATA_DIR=.data/server
CETRINW_PYTHON=.venv/bin/python
CETRINW_WORKER=workers/market.py
# External binding requires a random device token of at least 32 characters.
# CETRINW_TOKEN=
# TUSHARE_TOKEN=
# FRED_API_KEY=
# CETRINW_USER_AGENT=Cetrinw personal research contact@example.com
# Optional: resolve the SPA bundle and the bundled dictionary when the server is not
# started from the repository root.
# CETRINW_DIST=dist
# CETRINW_DICTIONARY=resources/dictionary.sqlite3
